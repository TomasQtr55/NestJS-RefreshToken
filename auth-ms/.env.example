# --- Microservice (TCP transport) ---
# auth-ms does NOT expose HTTP. It only listens for TCP messages from the gateway.
AUTH_MS_HOST=127.0.0.1
AUTH_MS_PORT=3001

# --- Database (Prisma) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_db?schema=public"

# --- Access token (JWT) ---
# MUST be identical in gateway/.env — auth-ms signs, gateway verifies.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900

# --- Refresh token ---
REFRESH_TOKEN_TTL_DAYS=7
