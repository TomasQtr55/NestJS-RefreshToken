# --- HTTP server (the only public entry point) ---
PORT=3000

# --- TCP client toward auth-ms (must match auth-ms listener) ---
AUTH_MS_HOST=127.0.0.1
AUTH_MS_PORT=3001

# --- Access token (JWT) ---
# MUST be identical to auth-ms/.env — auth-ms signs, gateway verifies locally.
# NOTE: the gateway has NO DATABASE_URL and NO refresh token config.
# That isolation is intentional: auth data belongs to auth-ms alone.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
